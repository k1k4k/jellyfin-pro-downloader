<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Une même source, deux artefacts (jamais une DLL pour les deux) :
      JellyfinTarget=jf12 -> Jellyfin 12.x,   .NET 10  (défaut)
      JellyfinTarget=jf10 -> Jellyfin 10.11.x, .NET 9
    dotnet build -c Release -p:JellyfinTarget=jf10
  -->
  <PropertyGroup>
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">jf12</JellyfinTarget>

    <RootNamespace>Jellyfin.Plugin.ProDownloader</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ProDownloader</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Épinglé à la première version de chaque ligne : un serveur plus récent satisfait la référence. -->
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf12'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <DefineConstants>$(DefineConstants);JF12</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf10'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinVersion>10.11.0</JellyfinVersion>
    <DefineConstants>$(DefineConstants);JF10</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le script client à la racine du dépôt est la source de vérité. -->
    <EmbeddedResource Include="..\jellyfin-pro-downloader.js" LogicalName="Jellyfin.Plugin.ProDownloader.jellyfin-pro-downloader.js" />
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
